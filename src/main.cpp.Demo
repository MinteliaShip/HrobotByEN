#include <Arduino.h>
#include <servoICS.h>

HardwareSerial* ServoSerial = &Serial1;
const char enPin = 23;
const char txPin = 19;
const char rxPin = 22;
const long bpsServo = 115200;

servoICS::Servo servoDEMOS(ServoSerial,enPin,12);
void setup() {

  servoDEMOS.setOffset();

  Serial.begin(115200);
  ServoSerial->begin(bpsServo,SERIAL_8E1,rxPin,txPin);  //SERIAL_8E1がICS規格で使用されている。
}

void loop() {
  auto log = servoDEMOS.setPos(0).getPos();
  Serial.println(log.error_msg);
  Serial.println(log.value);
  delay(10);
}