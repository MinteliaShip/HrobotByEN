#pragma once
// ==============================================================
// ファーム用エクスポートデータ（PCアプリの「エクスポート (.h)」がこのファイルを丸ごと書き換える）
//  - 校正値（calib_data）と、モーション（モーション名の namespace）を1つのファイルにまとめる。
//  - モーションは Motion.h で DECLARE_DATA_MOTION(クラス名, モーション名, 部位ビット) と宣言して使う。
//  - モーションの値は論理ICS（7500 = 校正済みの中立, 0 = FREE, -1 = その軸は触らない）。
//    1行 = 1制御周期（1000 / FPS ミリ秒）。
// ==============================================================
#include <stdint.h>

struct ExportFrame { int16_t v[19]; };

namespace export_data {
inline constexpr uint16_t FPS = 40;   // 書き出したときの制御周期（Config の G_fps と同じにすること）
}

// ---- 校正値 ----
namespace calib_data {
// サーボごとのオフセット（生ICSで論理7500=中立になる値。範囲 3500〜11500）
inline constexpr int16_t OFFSET[19] = {
    7500,                           // [0] 腰
    7500, 7500, 7500, 7500,         // [1..4] 左腕
    7500, 7500, 7500, 7500,         // [5..8] 右腕
    7500, 7676, 7710, 7777, 7600,   // [9..13] 左脚
    7500, 7575, 7299, 7299, 7720    // [14..18] 右脚
};
// 左右の脚の高さ補正 [mm]
inline constexpr float FOOTDEF_L = 0.0f;
inline constexpr float FOOTDEF_R = 20.0f;
} // namespace calib_data

// ---- モーション ----
// （まだありません）
